# ============================================================================
# AttendEase - Environment Variables Template
# Copy this file to .env and fill in your actual values
# ============================================================================

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Azure AD Configuration (for Microsoft 365 authentication)
AAD_APP_CLIENT_ID=your-azure-client-id
AAD_APP_CLIENT_SECRET=your-azure-client-secret
AAD_APP_TENANT_ID=your-azure-tenant-id

# Database Connection (for migrations)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# Application Configuration
NODE_ENV=development
PORT=3333
APP_NAME=AttendEase

# Admin Configuration
ADMIN_EMAIL=admin@attendease.com
ADMIN_DEFAULT_PASSWORD=ChangeMe123!

# JWT Configuration
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRATION=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
VITE_FRONTEND_URL=http://localhost:3000

# VITE Frontend Variables
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_AAD_APP_CLIENT_ID=your-azure-client-id

# Python Service Configuration
PYTHON_SERVICE_PORT=5000
PYTHON_SERVICE_HOST=localhost

# Feature Flags
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_DEBUG_MODE=true
